<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Counter4Egr2OB.Models"
             x:Class="Counter4Egr2OB.Views.CountersPage"
             Title="CountersPage">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add"
                     Clicked="Add_Clicked" />
    </ContentPage.ToolbarItems>
    <CollectionView x:Name="counterCollection"
                    Margin="20">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical"
                             Span="5"
                             VerticalItemSpacing="20"
                             HorizontalItemSpacing="20"/>
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Counter">
                <Border WidthRequest="160"
                        Margin="0,0,20,20"
                        Padding="10"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding Name}"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Value}"
                                FontSize="40"
                                HorizontalOptions="Center" />
                        <HorizontalStackLayout HorizontalOptions="Center">
                            <Button Text="-"
                                    Clicked="OnMinusClicked" />
                            <Button Text="+"
                                    Clicked="OnPlusClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>