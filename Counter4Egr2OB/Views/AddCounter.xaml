<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter4Egr2OB.Views.AddCounter"
             Title="AddCounter">
    <VerticalStackLayout Spacing="10"
                         Margin="5">
        <Entry x:Name="CounterName"
                Placeholder="Your new counter name"/>
        <Entry x:Name="StartValue"
               Placeholder="Starting value (default 0)"
               Keyboard="Numeric"/>
        <Button Clicked="CreateCounter"
                Text="Add"/>
    </VerticalStackLayout>
</ContentPage>